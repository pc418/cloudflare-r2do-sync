// LOCAL TEST CONFIG ONLY.
// This file exists solely so @cloudflare/vitest-pool-workers can construct the
// test runtime bindings. NEVER deploy with the wrangler CLI — the local wrangler
// login belongs to a DIFFERENT Cloudflare account. Deploys go through
// scripts/deploy.mjs (REST API, token from ../.env).
//
// These names are LIVE. `name` is the deployed Worker and half of its workers.dev hostname;
// `bucket_name` holds the vault; `class_name` owns the authoritative head. Renaming any of
// them is a migration, not an edit — a new script name is a new, empty Durable Object, and a
// renamed class needs `renamed_classes` or the existing namespace is orphaned. `deploy.mjs`
// refuses the fork (`assertNoRenameFork`); see the runbook before changing one.
{
  "name": "obsidian-log-sync",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-03",
  "compatibility_flags": ["nodejs_compat"],
  "durable_objects": {
    "bindings": [{ "name": "VAULT_LOCK", "class_name": "VaultLock" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["VaultLock"] }],
  "r2_buckets": [{ "binding": "VAULT", "bucket_name": "obsidian-log-sync" }],
  // Retention. Deploy-time configuration, read by scripts/deploy.mjs and shipped as plain-text
  // bindings, so these values are what a deployed sweep actually applies. Strings on purpose:
  // the REST binding type is plain_text, and a number here would give the local test runtime a
  // different type than production. Shrinking either one widens the window in which a device
  // that has been away loses its merge base (conflict copies instead of clean diff3) and
  // cannot verify that a served head descends from the one it last absorbed.
  "vars": { "GC_KEEP_DAYS": "30", "GC_KEEP_COUNT": "50" },
  "triggers": { "crons": ["0 4 * * *"] }
}
