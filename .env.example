# Copy to .env and fill in. .env is gitignored and must never be committed.
#
# None of this is needed for the normal path: `node scripts/setup.mjs` deploys with the
# wrangler CLI login. These variables select the REST-API path instead (`--token`), for CI
# or for a machine whose wrangler is signed in to a different Cloudflare account.

# Cloudflare API token used by scripts/setup.mjs --token and scripts/deploy.mjs.
# Scopes: Workers Scripts:Edit, Workers R2 Storage:Edit.
CLOUDFLARE_TOKEN=

# Cloudflare dashboard -> Workers & Pages -> Account ID.
CLOUDFLARE_ACCOUNT_ID=

# Base URL of the deployed Worker. Written here automatically by setup/deploy.
# Used by scripts/access-token.mjs and scripts/restore.mjs; there is deliberately no
# default, because guessing the wrong host would send an admin token somewhere it does
# not belong.
WORKER_URL=

# Admin credential for issuing/revoking access tokens — managed automatically: setup and
# deploy write it here, reuse it while it matches the deployed secret, and rotate it when
# it does not (existing access tokens are unaffected). Delete the line if you prefer
# scripts/access-token.mjs to ask for it with hidden input instead.
ADMIN_TOKEN=
