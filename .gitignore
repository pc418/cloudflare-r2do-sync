.env
# Every named deployment writes its own credentials file (.env.notes-2, …), each holding an
# ADMIN_TOKEN that mints vault-wide access tokens. Ignoring only the exact name `.env` left
# them untracked-but-addable, so a routine `git add -A` would publish them.
.env.*
!.env.example
node_modules/
dist/
.DS_Store
docs/
testvault/
