{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022", "DOM"],
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "types": ["vitest/globals"]
  },
  // `test/live` has its own project: it is Node code, and it needs the `obsidian` alias.
  "include": ["src/**/*.ts", "test/**/*.ts"],
  "exclude": ["test/live/**"]
}
